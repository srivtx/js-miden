generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Policy {
  id            String    @id @default(cuid())
  policyNumber  String    @unique
  holderName    String
  holderEmail   String
  startDate     DateTime
  endDate       DateTime
  coverageLimit Decimal   @db.Decimal(12, 2)
  deductible    Decimal   @db.Decimal(10, 2)
  type          PolicyType
  status        PolicyStatus @default(ACTIVE)

  claims Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Claim {
  id              String        @id @default(cuid())
  policyId        String
  claimNumber     String        @unique
  incidentDate    DateTime
  description     String
  amountRequested Decimal       @db.Decimal(12, 2)
  amountApproved  Decimal?      @db.Decimal(12, 2)
  amountPaid      Decimal?      @db.Decimal(12, 2)
  status          ClaimStatus   @default(SUBMITTED)
  fraudScore      Int           @default(0)
  fraudFlags      String[]
  adjusterId      String?
  documents       Document[]

  policy   Policy    @relation(fields: [policyId], references: [id])
  adjuster Adjuster? @relation(fields: [adjusterId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id       String @id @default(cuid())
  claimId  String
  fileName String
  fileType String
  fileSize Int
  url      String

  claim Claim @relation(fields: [claimId], references: [id])
}

model Adjuster {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  specialty String[]
  workload  Int      @default(0)
  isActive  Boolean  @default(true)

  claims Claim[]
}

model Payment {
  id          String        @id @default(cuid())
  claimId     String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  processedAt DateTime?

  claim Claim @relation(fields: [claimId], references: [id])
}

enum PolicyType {
  AUTO
  HOME
  HEALTH
  LIFE
  TRAVEL
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  PAID
}

enum PaymentMethod {
  CHECK
  ACH
  WIRE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
