generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now()) @map("created_at")

  shipmentsCreated Shipment[] @relation("CreatedBy")

  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  DRIVER
  WAREHOUSE_MANAGER
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  country   String
  latitude  Float
  longitude Float
  capacity  Int      @default(1000)
  createdAt DateTime @default(now()) @map("created_at")

  inventory  Inventory[]
  routeNodes RouteNode[]

  @@map("warehouses")
}

model Inventory {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  sku         String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, sku])
  @@map("inventory")
}

model Shipment {
  id            String        @id @default(uuid())
  trackingNumber String       @unique @map("tracking_number")
  status        ShipmentStatus @default(CREATED)
  originId      String        @map("origin_id")
  destinationId String        @map("destination_id")
  weight        Float
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deliveredAt   DateTime?     @map("delivered_at")

  origin      Warehouse @relation("Origin", fields: [originId], references: [id])
  destination Warehouse @relation("Destination", fields: [destinationId], references: [id])
  creator     User      @relation("CreatedBy", fields: [createdBy], references: [id])
  tracking    Tracking[]
  route       Route?    @relation("ShipmentRoute")

  @@map("shipments")
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_WAREHOUSE
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

model Tracking {
  id          String   @id @default(uuid())
  shipmentId  String   @map("shipment_id")
  status      ShipmentStatus
  location    String?
  latitude    Float?
  longitude   Float?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@map("tracking")
}

model Route {
  id          String   @id @default(uuid())
  shipmentId  String   @unique @map("shipment_id")
  totalDistance Float  @map("total_distance")
  estimatedDays Int    @map("estimated_days")
  optimized   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation("ShipmentRoute", fields: [shipmentId], references: [id])
  nodes    RouteNode[]

  @@map("routes")
}

model RouteNode {
  id          String   @id @default(uuid())
  routeId     String   @map("route_id")
  warehouseId String   @map("warehouse_id")
  sequence    Int
  distanceKm  Float    @map("distance_km")

  route     Route     @relation(fields: [routeId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("route_nodes")
}
