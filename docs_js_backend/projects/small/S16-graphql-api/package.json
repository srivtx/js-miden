{
  "name": "s16-graphql-api",
  "version": "1.0.0",
  "description": "GraphQL Blog API with DataLoader",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "dataloader": "^2.2.2",
    "express": "^5.0.0",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
